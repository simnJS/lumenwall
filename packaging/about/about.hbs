<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lumenwall third-party notices</title>
<style>
  :root { color-scheme: light dark; --bg: #f6f6f9; --text: #16171c; --muted: #4d5060; --card: #ffffff; --border: #dedfe6; --accent: #9a4d00; }
  @media (prefers-color-scheme: dark) { :root { --bg: #111217; --text: #eeeff4; --muted: #a3a7b7; --card: #20232c; --border: #2c303b; --accent: #ffb347; } }
  body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.55 system-ui, "Segoe UI", Inter, Ubuntu, sans-serif; }
  main { max-width: 56rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
  h1 { font-size: 1.75rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.15rem; margin: 2.5rem 0 .75rem; }
  h3 { font-size: 1rem; margin: 0 0 .5rem; }
  p, li { color: var(--muted); }
  a { color: var(--accent); }
  .license { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1rem 1.25rem; margin: 1rem 0; }
  .used-by { columns: 2; padding-left: 1.2rem; font-size: .9rem; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .8rem; color: var(--text); }
</style>
</head>
<body>
<main>
<h1>Third-party notices</h1>
<p>Lumenwall is free software under the MIT or Apache-2.0 license. Its programs include the Rust crates listed below, under the licences that follow.</p>
<!-- lumenwall:bundled-libraries (package.py puts the libraries shipped as separate files here: FFmpeg and CEF in the Windows archive) -->

<h2>Licences</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

<h2>Licence texts</h2>
{{#each licenses}}
<section class="license" id="{{id}}">
  <h3>{{name}}</h3>
  <p>Used by:</p>
  <ul class="used-by">
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
